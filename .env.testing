# Test environment.
#
# The container injects the development values as real environment variables
# (docker-compose `env_file`), which outrank phpunit.xml's <env> entries. The
# `./rblog test` wrapper therefore passes APP_ENV and DB_DATABASE explicitly,
# and this file carries the rest.
APP_ENV=testing
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=redesblog_testing
DB_USERNAME=redesblog
DB_PASSWORD=secret

BCRYPT_ROUNDS=4
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=s3
